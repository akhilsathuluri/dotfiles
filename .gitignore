*.swp
*~
.DS_Store
Thumbs.db
.task/

# Worktrees Claude Code creates for isolated sessions and subagents.
.claude/worktrees/
bash/.bashrc.d/local.bash
hunk/.config/hunk/state.json
bat/.config/bat/themes/
# stow folds ~/.config/systemd into this package, so `systemctl --user enable`
# writes its enablement symlink back in here - per-machine, absolute paths.
tmux/.config/systemd/user/timers.target.wants/

# Python bytecode: importing the dictate script (e.g. to test it) leaves these
# inside the stow package, where `task perms` then flags them.
__pycache__/

# Rust build output (apps/folio)
apps/folio/target/
apps/folio/bin/
apps/folio/tests/snapshots/*.snap.new
