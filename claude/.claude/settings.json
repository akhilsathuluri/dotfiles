{
  "permissions": {
    "allow": [
      "mcp__plugin_Notion_notion__notion-search",
      "mcp__plugin_Notion_notion__notion-fetch",
      "mcp__plugin_Notion_notion__notion-download-attachment",
      "mcp__plugin_Notion_notion__notion-get-comments",
      "mcp__plugin_Notion_notion__notion-get-async-task",
      "mcp__plugin_Notion_notion__notion-get-teams",
      "mcp__plugin_Notion_notion__notion-get-users",
      "mcp__plugin_Notion_notion__notion-query-data-sources",
      "mcp__plugin_Notion_notion__notion-query-database-view",
      "mcp__plugin_Notion_notion__notion-query-meeting-notes",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_canvas",
      "mcp__claude_ai_Slack__slack_read_file",
      "mcp__claude_ai_Slack__slack_read_user_profile",
      "mcp__claude_ai_Slack__slack_get_reactions",
      "mcp__claude_ai_Slack__slack_list_channel_members",
      "mcp__claude_ai_Slack__slack_search_public",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_search_emojis",
      "Read(~/vaults/**)",
      "Edit(~/vaults/**)"
    ],
    "deny": [
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_add_reaction",
      "mcp__claude_ai_Slack__slack_create_conversation",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__plugin_Notion_notion__notion-create-pages",
      "mcp__plugin_Notion_notion__notion-update-page",
      "mcp__plugin_Notion_notion__notion-move-pages",
      "mcp__plugin_Notion_notion__notion-duplicate-page",
      "mcp__plugin_Notion_notion__notion-create-database",
      "mcp__plugin_Notion_notion__notion-update-data-source",
      "mcp__plugin_Notion_notion__notion-create-comment",
      "mcp__plugin_Notion_notion__notion-create-attachment",
      "mcp__plugin_Notion_notion__notion-create-view",
      "mcp__plugin_Notion_notion__notion-update-view"
    ]
  },
  "hooks": {
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/on-notification.sh\" ] && \"$HOME/.claude/hooks/on-notification.sh\" || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/on-pre-tool-use.sh\" ] && \"$HOME/.claude/hooks/on-pre-tool-use.sh\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/on-session-end.sh\" ] && \"$HOME/.claude/hooks/on-session-end.sh\" || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/on-stop.sh\" ] && \"$HOME/.claude/hooks/on-stop.sh\" || true"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" ] && \"$HOME/dotfiles/apps/agentbar/bin/agentbar\" hook || true"
          },
          {
            "type": "command",
            "command": "[ -x \"$HOME/.claude/hooks/on-prompt-submit.sh\" ] && \"$HOME/.claude/hooks/on-prompt-submit.sh\" || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "notion-workspace-plugin@notion-plugin-marketplace": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "notion-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "makenotion/claude-code-notion-plugin"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
