# Theme -- no `theme =` here, so Ghostty uses its own built-in default (dark).
# The `theme` switcher overrides it via this optional include, which never edits
# this tracked file. Missing file (no switch yet) = stays on Ghostty's default.
config-file = ?~/.config/theme/ghostty.conf
window-theme = ghostty

# Font — use the system default monospace

# Cursor
cursor-style = block
cursor-style-blink = false

# Cursor trail (Neovide-like warp effect via custom shader)
# https://github.com/sahaj-b/ghostty-cursor-shaders
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always

# Hide mouse cursor while typing
mouse-hide-while-typing = true

# Disable click-to-move-cursor at the prompt. Ghostty 1.3+ emits cursor motion
# when you click in the zsh prompt (OSC 133 cl=line), but this misbehaves inside
# tmux -- the cursor snaps to the start of the line and selection/copy breaks.
# See tmux#4931 / ghostty#11433.
cursor-click-to-move = false

# Selecting text auto-copies to clipboard (suppress toast)
copy-on-select = clipboard
app-notifications = no-clipboard-copy

# Don't fire desktop notifications (avoids dock badge counter)
desktop-notifications = false

# Don't ring the bell when a foreground command finishes (Ghostty's default
# fires on every prompt-marker, causing the tab to flash on every command).
notify-on-command-finish-action = no-bell,no-notify

# Disable all bell reactions (audio, tab attention icon, title bell, etc.).
# Bell character or bell events from any source are now silently ignored.
bell-features = no-system,no-audio,no-attention,no-title,no-border

# Extend content background color into padding for a seamless look
window-padding-color = extend

# Distribute extra space as padding instead of leaving a gap
window-padding-balance = true

# SSH: install Ghostty's terminfo on the remote on first connect (needs `tic` there,
# cached after), falling back to TERM=xterm-256color - else remote tmux/nvim refuse to start.
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo,path

# Merge titlebar and tab bar into one compact row
gtk-titlebar-style = tabs
gtk-wide-tabs = false
gtk-custom-css = ~/.config/ghostty/style.css

# macOS: treat left Option as Alt so tmux/shell receive Alt+key escape sequences
# (Alt+; session picker, Alt+1..9 windows, Alt+j/k, Alt+m, Alt+y, Alt+C fzf).
# Right Option is left alone, so macOS special-char entry still works there
# (right-Option+8 for •, right-Option+G for ©, etc.).
macos-option-as-alt = left

# Tab navigation -- alt+h/l freed for tmux session switching (see .tmux.conf)
keybind = alt+h=unbind
keybind = alt+l=unbind


# Explicitly bind new tab to ghostty default (plain shell, no tmux)
keybind = ctrl+shift+t=new_tab

